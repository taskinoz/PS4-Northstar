# Settings for the development scripts in scripts/. Copy this file to .env
# (ignored by git) and fill in the values for your machine, or set the same
# variables in your environment, which take precedence.

# The shadPS4 game folder: the folder holding the game's eboot.bin and vpk_ps4.
NORTHSTAR_PS4_GAME_ROOT=

# The shadPS4.exe that the test scripts launch.
SHADPS4_EXE=

# shadPS4's user folder (log\ and data\). Defaults to %APPDATA%\shadPS4.
# SHADPS4_USER_DIR=

# Northstar's mods, as assembled by scripts/Build-NorthstarMods.py.
# Defaults to work\northstar-release\1.31.13\mods.
# NORTHSTAR_MODS_ROOT=

# The game's VPK files unpacked (frontend\ and mp_common\), for the KeyValues
# checks in Test-NorthstarProfile.ps1 against real files. Defaults to work\extracted.
# PS4_EXTRACTED_ROOT=

# The OpenOrbis toolchain. Defaults to tools\openorbis-0.5.4\OpenOrbis\PS4Toolchain.
# OO_PS4_TOOLCHAIN=

# A PS4 running GoldHEN, for scripts/ps4/ (FTP on port 2121, kernel log on 3232).
# PS4_ADDRESS=
