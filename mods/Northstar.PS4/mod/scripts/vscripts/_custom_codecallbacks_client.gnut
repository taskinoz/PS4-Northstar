global function AddCallback_OnPreSendMessage

// PS4 Northstar.PS4 override: this file is real Northstar.Client content
// (copied verbatim from the PC install) plus the addition below.
// AddServerToClientStringCommandCallback is a Northstar-ecosystem helper
// (not vanilla engine-native, not defined anywhere in Northstar.Client's own
// scripts either -- its real implementation is entirely native, part of
// NorthstarLauncher's C++ ns_script_servertoclientstringcommand ConCommand,
// which doesn't exist on this port) that several mp_common scripts call
// (sh_damage_types.nut, sh_message_utils.gnut, sh_custom_scoreboard_columns.gnut)
// to register a handler for custom string commands a server can push.
// Without a definition anywhere, referencing it is an unrecoverable
// boot-time compile error (confirmed live 2026-08-08 connecting to a real
// server -- see docs/TECHNICAL-NOTES.md). Stubbed here as a no-op so those
// call sites compile; registered callbacks are silently dropped. If a
// server-driven feature that depends on this (certain custom scoreboard
// columns, custom HUD messages) turns out to matter, the real fix is
// implementing the native ConCommand + dispatch in launcher/src/runtime.cpp,
// not expanding this stub.
//
// This lives here, not hand-patched into the real Northstar.Client copy,
// because Build-Stage1ModIntegration.ps1 re-stages Northstar.Client's real
// files on every run -- a hand-edit there would just get silently
// overwritten again. Northstar.PS4 has LoadPriority 99 (loads/stages last),
// so this copy wins over Northstar.Client's for this one shared path.
global function AddServerToClientStringCommandCallback

// NSChatWriteRaw is a genuine NorthstarLauncher native (ADD_SQFUNC, CLIENT
// context, primedev/scripts/client/clientchathooks.cpp) that writes text
// directly into the local chat HUD via LocalChatWriter. This port doesn't
// register it as a native, so every call site in this same file's own
// OnReceivedMessage (chat message formatting) hit an unrecoverable
// boot-time "CLIENT SCRIPT COMPILE ERROR: Undefined variable" the moment a
// real chat message was ever processed -- confirmed live 2026-08-17
// connecting to a real server; shadPS4/this port doesn't surface the
// FatalError on screen at all, so it just looks like a silent freeze on
// connect rather than an error (see docs/TECHNICAL-NOTES.md). Stubbed here
// as a no-op so those call sites compile; chat text silently doesn't
// appear. If chat turns out to matter, the real fix is implementing the
// native in launcher/src/runtime.cpp (mirroring LocalChatWriter's
// behavior), not expanding this stub.
global function NSChatWriteRaw

// NSChatWrite, NSChatWriteLine, and NSSendMessage are three more real
// NorthstarLauncher CLIENT natives used by this same file's chat-formatting
// code, plus by Northstar.Client's client/cl_chat.gnut
// (primedev/scripts/client/clientchathooks.cpp -- add a fully-formatted
// line/text to the CHudChat HUD; primedev/client/chatcommand.cpp -- sends
// the local player's own chat message onward, normally forwarding to the
// server). Same missing-native class of bug as NSChatWriteRaw above, found
// in the same pass (compilation stops at the first undefined variable, so
// these were only discovered once NSChatWriteRaw was stubbed). Stubbed as
// no-ops for the same reason: chat display/sending silently does nothing
// rather than crashing the whole client script VM. Declared here rather
// than in cl_chat.gnut itself because this file compiles first --
// Northstar.Client's mod.json lists _custom_codecallbacks_client.gnut
// (Path index 62) before client/cl_chat.gnut (Path index 66), and that
// relative order carries into the merged scripts.rson (Build-Stage1ModIntegration.ps1
// creates each mod's rson entries in its own Scripts[] order; Northstar.PS4's
// override of this file wins on file *content* via LoadPriority 99, but
// its rson *entry position* is created at Northstar.Client's point in the
// merge, since dedup keeps only the first-seen entry for a given path).
global function NSChatWrite
global function NSChatWriteLine
global function NSSendMessage

// this is global due to squirrel bridge v3 making native not be able to find non-global funcs properly
// temp fix (surely it will get replaced), do not use this function please (although there isnt rly a downside to it?)
global function CHudChat_ProcessMessageStartThread

global function NS_PreSendMessage

global struct ClClient_MessageStruct
{
	string message
	entity player
	string playerName
	bool isTeam
	bool isDead
	bool isWhisper
	bool shouldBlock
	bool noServerTag
}

global struct ClClient_PreMessageStruct
{
	string message
	bool isIngame
	bool isTeam
	bool sendMessage
}

struct
{
	array<ClClient_MessageStruct functionref( ClClient_MessageStruct )> OnReceivedSayTextMessageCallbacks
	array<ClClient_PreMessageStruct functionref( ClClient_PreMessageStruct )> OnPreSendMessageCallbacks
} NsCustomCallbacksClient

void function OnReceivedMessage( ClClient_MessageStruct localMessage )
{
	if ( IsWatchingReplay() && localMessage.player == null )
		return

	if ( localMessage.player != null )
	{
		foreach ( callbackFunc in NsCustomCallbacksClient.OnReceivedSayTextMessageCallbacks )
		{
			ClClient_MessageStruct returnStruct = callbackFunc( localMessage )
			localMessage.message = returnStruct.message
			localMessage.playerName = returnStruct.playerName
			localMessage.isTeam = returnStruct.isTeam
			localMessage.isDead = returnStruct.isDead
			localMessage.isWhisper = returnStruct.isWhisper
			localMessage.shouldBlock = localMessage.shouldBlock || returnStruct.shouldBlock
			localMessage.noServerTag = returnStruct.noServerTag
		}
	}

	if ( localMessage.shouldBlock )
	{
		return
	}

	NSChatWriteRaw( 1, "\n" )

	if ( localMessage.player == null )
	{
		if ( !localMessage.noServerTag || localMessage.isWhisper )
		{
			NSChatWrite( 1, "\x1b[95m" )
		}
	}
	else
	{
		bool isFriendly = localMessage.player.GetTeam() == GetLocalClientPlayer().GetTeam()

		if ( isFriendly )
			NSChatWrite( 1, "\x1b[111m" )
		else
			NSChatWrite( 1, "\x1b[112m" )
	}

	if ( localMessage.isWhisper )
		NSChatWriteRaw( 1, Localize( "#HUD_CHAT_WHISPER_PREFIX" ) )
	if ( localMessage.isDead )
		NSChatWriteRaw( 1, Localize( "#HUD_CHAT_DEAD_PREFIX" ) )
	if ( localMessage.isTeam )
		NSChatWriteRaw( 1, Localize( "#HUD_CHAT_TEAM_PREFIX" ) )

	if ( localMessage.player == null )
	{
		if ( !localMessage.noServerTag )
		{
			NSChatWriteRaw( 1, Localize( "#HUD_CHAT_SERVER_PREFIX" ) + " " )
		}
	}
	else
	{
		NSChatWriteRaw( 1, localMessage.playerName )
		NSChatWriteRaw( 1, ": " )
	}

	if ( localMessage.player != null || !localMessage.noServerTag || localMessage.isWhisper )
		NSChatWrite( 1, "\x1b[0m" )
	NSChatWrite( 1, localMessage.message )
}

void function CHudChat_ProcessMessageStartThread( int playerIndex, string message, bool isTeam, bool isDead, int messageType )
{
	thread CHudChat_OnReceivedSayTextMessageCallback( playerIndex, message, isTeam, isDead, messageType )
}

void function NS_PreSendMessage( string message, bool isIngame, bool isTeam )
{
	ClClient_PreMessageStruct messageStruct
	messageStruct.message = message
	messageStruct.isIngame = isIngame
	messageStruct.isTeam = isTeam
	messageStruct.sendMessage = true

	foreach ( callbackFunc in NsCustomCallbacksClient.OnPreSendMessageCallbacks )
	{
		callbackFunc( messageStruct )
	}

	if ( messageStruct.sendMessage )
	{
		NSSendMessage( messageStruct.message, messageStruct.isIngame, messageStruct.isTeam )
	}
}

void function CHudChat_OnReceivedSayTextMessageCallback( int fromPlayerIndex, string message, bool isTeam, bool isDead, int messageType )
{
	entity fromPlayer = null
	string fromPlayerName = ""

	if ( fromPlayerIndex >= 0 && fromPlayerIndex <= 128 )
	{
		fromPlayer = GetEntByIndex( fromPlayerIndex + 1 )
		if ( fromPlayer == null )
		{
			print( "Ignored chat message from invalid player index " + fromPlayerIndex + ": " + message )
			return
		}

		fromPlayerName = fromPlayer.GetPlayerNameWithClanTag()
	}

	// Null player + isTeam == true: Server with no tag.

	if ( messageType == 0 || messageType == 1 )
	{
		ClClient_MessageStruct localMessage
		localMessage.message = message
		localMessage.player = fromPlayer
		localMessage.playerName = fromPlayerName
		localMessage.isTeam = fromPlayer != null && isTeam
		localMessage.isDead = isDead
		localMessage.isWhisper = false
		localMessage.shouldBlock = false
		localMessage.noServerTag = fromPlayer == null && isTeam
		OnReceivedMessage( localMessage )
		return
	}

	if ( messageType == 2 )
	{
		ClClient_MessageStruct localMessage
		localMessage.message = message
		localMessage.player = fromPlayer
		localMessage.playerName = fromPlayerName
		localMessage.isTeam = fromPlayer != null && isTeam
		localMessage.isDead = isDead
		localMessage.isWhisper = true
		localMessage.shouldBlock = false
		localMessage.noServerTag = fromPlayer == null && isTeam
		OnReceivedMessage( localMessage )
		return
	}
}

void function AddCallback_OnReceivedSayTextMessage( ClClient_MessageStruct functionref( ClClient_MessageStruct ) callbackFunc )
{
	NsCustomCallbacksClient.OnReceivedSayTextMessageCallbacks.append( callbackFunc )
}

void function AddCallback_OnPreSendMessage( ClClient_PreMessageStruct functionref( ClClient_PreMessageStruct ) callbackFunc )
{
	NsCustomCallbacksClient.OnPreSendMessageCallbacks.append( callbackFunc )
}

