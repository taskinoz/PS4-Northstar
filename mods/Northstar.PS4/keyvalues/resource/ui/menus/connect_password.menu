// Northstar.PS4: the password box and the Connect button have no navigation
// links, and PS4 moves focus only along explicit links, so with a pad the
// Connect button could not be reached (on PC it is clicked with the mouse or
// Enter is pressed). Down from the box reaches it and up returns. (The root key
// is mods_browse.menu in Northstar.Client's file too; the merge matches on it.)
resource/ui/menus/mods_browse.menu
{
	menu
	{
		EnterPasswordBox
		{
			navDown ConnectButton
		}

		ConnectButton
		{
			navUp EnterPasswordBox
		}
	}
}
