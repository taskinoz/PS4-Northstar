{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NorthstarPS4 Token Helper",
  "mainBinaryName": "NorthstarPS4TokenHelper",
  "version": "1.0.0",
  "identifier": "com.northstarps4.tokenhelper",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NorthstarPS4 Token Helper",
        "width": 640,
        "height": 860,
        "minWidth": 420,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#06102a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage"],
    "category": "Utility",
    "shortDescription": "Signs Northstar on a PS4, or in shadPS4, in through the EA app.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
